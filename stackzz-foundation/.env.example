# -----------------------------------------------------------------------------
# Stackzz Foundation environment variables
# Copy this file to .env.local for local work, and add the same values in
# Vercel → Project → Settings → Environment Variables. Everything is optional
# for a first preview: without keys, form submissions print to the server log.
# Never commit .env.local.
# -----------------------------------------------------------------------------

# Public address of the site, no trailing slash. Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Resend (resend.com → API Keys). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Stackzz Foundation <hello@your-domain.org>"
# Inbox that receives every form submission
CONTACT_TO_EMAIL=
# Optional: Resend segment ID for the newsletter list (Resend → Audience → Segments)
RESEND_NEWSLETTER_SEGMENT_ID=

# Stripe (dashboard.stripe.com → Developers → API keys → Secret key).
# Leave empty until the foundation's Stripe account is ready; the Give Back
# page collects pledges until then.
STRIPE_SECRET_KEY=
