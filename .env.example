# -----------------------------------------------------------------------------
# AB Development environment variables
# Copy this file to .env.local for local development, and add the same values
# in Vercel → Project → Settings → Environment Variables.
# Variables starting with NEXT_PUBLIC_ are visible in the browser; all others
# are server-only secrets. Never commit .env.local.
# -----------------------------------------------------------------------------

# Public URL of the site (no trailing slash). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://abdevelopment.ai

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com → API Keys). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="AB Development <hello@abdevelopment.ai>"
# Where new inquiries are sent (defaults to the email in src/config/business.ts)
CONTACT_TO_EMAIL=Abdevelopsli@gmail.com

# Google Analytics 4 measurement ID (loads only after cookie consent)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: Cloudflare Turnstile spam protection (leave both empty to disable)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Long random string used to hash IP addresses for rate limiting.
# Generate one with:  openssl rand -hex 32
RATE_LIMIT_SALT=

# Used only by `npm run seed:team`
SEED_OWNER_EMAIL=
SEED_MD_EMAIL=
